#!/bin/sh
#
# syncthing-launch
#

_syncthing_workaround() {
  _st_cfg="${STATEDIR:-$HOME/.local/state}/syncthing/config.xml"
  _address=$(awk '/<gui/ {in_gui=1} /<\/gui>/ {in_gui=0} in_gui && /<address>/ {sub(/.*<address>/, ""); sub(/<\/address>.*/, ""); print}' "$_st_cfg")
  # zenity --info --title="Syncthing Web GUI" --text="GUI Address: $_address"
  notify -di "Web GUI Address: $_address"
}

if [ -z "${1:-}" ]; then
  _choice=$(zenity --list --radiolist --column="Select" --column="Item" TRUE "start syncthing ui" FALSE "start syncthing server") || >&2 echo "Cancel was clicked or dialog was closed"
 
  case "$_choice" in
    "start syncthing ui")
      >&2 echo "start syncthing ui was selected"
      _syncthing_workaround ;;
    "start syncthing server")
      >&2 echo "start syncthing server was selected"
      syncthing serve --no-browser --logfile=default ;;
  esac

else

  syncthing "$@"

fi
